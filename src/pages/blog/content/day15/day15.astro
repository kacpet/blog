---
import Layout from '../../../../layouts/Layout.astro'
import DayRating from '../../rateDay/rateDay.astro'

export const post = {
  day: 15,
  title: 'Day 15',
  date: '2026-09-20',
  description: 'fiveteenth day, of daily',
  category: 'Daily',
  tags: ['Astro', 'Tailwind CSS', 'Web Development'],
}
---

<Layout>
  <article class="mx-auto max-w-3xl px-6 pb-24 pt-32">
    <!-- Header -->
    <header class="mb-16">
      <div class="flex items-center gap-3 text-sm">
        <span
          class="font-medium uppercase tracking-widest text-[var(--secondary)]"
        >
          {post.category}
        </span>

        <span class="text-[var(--border)]">/</span>

        <span class="text-[var(--muted)]">
          Day {post.day}
        </span>
      </div>

      <h1
        class="mt-6 text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl"
      >
        {post.title}
      </h1>

      <p class="mt-5 text-sm text-[var(--muted)]">
        {
          new Date(post.date).toLocaleDateString('en-GB', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          })
        }
      </p>

      <p
        class="mt-8 border-l-2 border-[var(--secondary)] pl-5 text-lg leading-8 text-[var(--muted)] sm:text-xl"
      >
        {post.description}
      </p>
    </header>

    <!-- Content -->
    <div class="space-y-14 leading-8">
      <!-- Section -->
      <section>
        <h2 class="mb-5 text-2xl font-semibold tracking-tight sm:text-3xl">
          What I did today?
        </h2>
        <p>
          Today, I had free day, so I started writing code at my next project
          repo, I wrote part of code, and at some point i realized my Font in
          Editor don't work correctly I fixed that,I read a bit and I watched
          series with family, and i go to sleep early
        </p>
      </section>
    </div>

    <!-- Section -->
    <section class="py-5">
      <h2 class="mb-5 text-2xl font-semibold tracking-tight sm:text-3xl">
        Plans for tomorrow
      </h2>

      <p>
        I'll meet with my friend last time before studies, We'll play pool, I'll
        try to learn something new
      </p>
    </section>

    <!-- Section -->
    <section>
      <h2 class="mb-5 text-2xl font-semibold tracking-tight sm:text-3xl">
        How I rate this day
      </h2>
      <div class="space-y-4">
        <p>
          I'll gave 3/10, I didn't do anything big but at least I did something
        </p>
      </div>
      <DayRating class="w-full" rating={3} />
    </section>
  </article>
</Layout>
