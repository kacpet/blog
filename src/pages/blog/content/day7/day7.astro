---
import Layout from '../../../../layouts/Layout.astro'
import DayRating from '../../rateDay/rateDay.astro'

export const post = {
  day: 7,
  title: 'Day 7',
  date: '2026-09-12',
  description: 'seveth day, of daily',
  category: 'Daily',
  tags: ['Astro', 'Tailwind CSS', 'Web Development'],
}
---

<Layout>
  <article class="mx-auto max-w-3xl px-6 pb-24 pt-32">
    <!-- Header -->
    <header class="mb-16">
      <div class="flex items-center gap-3 text-sm">
        <span
          class="font-medium uppercase tracking-widest text-[var(--secondary)]"
        >
          {post.category}
        </span>

        <span class="text-[var(--border)]">/</span>

        <span class="text-[var(--muted)]">
          Day {post.day}
        </span>
      </div>

      <h1
        class="mt-6 text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl"
      >
        {post.title}
      </h1>

      <p class="mt-5 text-sm text-[var(--muted)]">
        {
          new Date(post.date).toLocaleDateString('en-GB', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          })
        }
      </p>

      <p
        class="mt-8 border-l-2 border-[var(--secondary)] pl-5 text-lg leading-8 text-[var(--muted)] sm:text-xl"
      >
        {post.description}
      </p>
    </header>

    <!-- Content -->
    <div class="space-y-14 leading-8">
      <!-- Section -->
      <section>
        <h2 class="mb-5 text-2xl font-semibold tracking-tight sm:text-3xl">
          What I did today?
        </h2>
        <p>
          Today I meet with my friend, because of that I slept about 3h,We
          decided to change idea. I'm glad that I could work after that, I
          listened audiobook named "Lean Startup method", the most important
          strategy in this book is about how to head up their workers, and the
          don't do everything they can but only one thing at o ce because it
          should be faster, and some other tips for businesman, and I started
          another one about creativity
        </p>
      </section>
    </div>

    <!-- Section -->
    <section class="py-5">
      <h2 class="mb-5 text-2xl font-semibold tracking-tight sm:text-3xl">
        Plans for tomorrow
      </h2>

      <p>I FINALLY have free day so I'll learn English, and Next JS</p>
    </section>

    <!-- Section -->
    <section>
      <h2 class="mb-5 text-2xl font-semibold tracking-tight sm:text-3xl">
        How I rate this day
      </h2>
      <div class="space-y-4">
        <p>I'll give 7/10, but I probably did more things than i should</p>
      </div>
    </section>
    <DayRating class="w-full" rating={7} />
  </article>
</Layout>
