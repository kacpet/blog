---
import Layout from '../../../../layouts/Layout.astro'
import DayRating from '../../rateDay/rateDay.astro'

export const post = {
  day: 37,
  title: 'Day 37',
  date: '2026-10-12',
  description: 'My first physic lesson',
  category: 'Daily',
  tags: ['Astro', 'Tailwind CSS', 'Web Development'],
}
---

<Layout>
  <article class="mx-auto max-w-3xl px-6 pb-24 pt-32">
    <!-- Header -->
    <header class="mb-16">
      <div class="flex items-center gap-3 text-sm">
        <span
          class="font-medium uppercase tracking-widest text-[var(--secondary)]"
        >
          {post.category}
        </span>

        <span class="text-[var(--border)]">/</span>

        <span class="text-[var(--muted)]">
          Day {post.day}
        </span>
      </div>

      <h1
        class="mt-6 text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl"
      >
        {post.title}
      </h1>

      <p class="mt-5 text-sm text-[var(--muted)]">
        {
          new Date(post.date).toLocaleDateString('en-GB', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          })
        }
      </p>

      <p
        class="mt-8 border-l-2 border-[var(--secondary)] pl-5 text-lg leading-8 text-[var(--muted)] sm:text-xl"
      >
        {post.description}
      </p>
    </header>

    <!-- Content -->
    <div class="space-y-14 leading-8">
      <!-- Section -->
      <section>
        <h2 class="mb-5 text-2xl font-semibold tracking-tight sm:text-3xl">
          What I did today?
        </h2>
        <p>
          Today, I bought some food, and I went for studies from 8 am to 2 pm, I
          returned to dormitory I made a dinner, and I went for a training, 2
          girls I trained was happy about how training looked , after this I had
          a e-learning, and he gave us a course I started and I made a big part
          of It, after this I needed to make a project for IT technologies, It
          taked a lot of time, after this I watched my notes, and I went to
          sleep
        </p>
      </section>
    </div>

    <!-- Section -->
    <section class="py-5">
      <h2 class="mb-5 text-2xl font-semibold tracking-tight sm:text-3xl">
        Plans for tomorrow, I'll prepare for math I have tomorrow, and I'll do
        part of course and I'll go at VeraSport at training
      </h2>

      <p></p>
    </section>

    <!-- Section -->
    <section>
      <h2 class="mb-5 text-2xl font-semibold tracking-tight sm:text-3xl">
        How I rate this day
      </h2>
      <div class="space-y-4">
        <p>
          I'll give 2/10, I was only at studies and I was at training nothing
          special
        </p>
        <DayRating class="w-full" rating={2} />
      </div>
    </section>
  </article>
</Layout>
