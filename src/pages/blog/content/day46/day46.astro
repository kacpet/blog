---
import Layout from '../../../../layouts/Layout.astro'
import DayRating from '../../rateDay/rateDay.astro'

export const post = {
  day: 46,
  title: 'Day 46',
  date: '2026-10-21',
  description: 'second day of using Structured',
  category: 'Daily',
  tags: ['Astro', 'Tailwind CSS', 'Web Development'],
}
---

<Layout>
  <article class="mx-auto max-w-3xl px-6 pb-24 pt-32">
    <!-- Header -->
    <header class="mb-16">
      <div class="flex items-center gap-3 text-sm">
        <span
          class="font-medium uppercase tracking-widest text-[var(--secondary)]"
        >
          {post.category}
        </span>

        <span class="text-[var(--border)]">/</span>

        <span class="text-[var(--muted)]">
          Day {post.day}
        </span>
      </div>

      <h1
        class="mt-6 text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl"
      >
        {post.title}
      </h1>

      <p class="mt-5 text-sm text-[var(--muted)]">
        {
          new Date(post.date).toLocaleDateString('en-GB', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          })
        }
      </p>

      <p
        class="mt-8 border-l-2 border-[var(--secondary)] pl-5 text-lg leading-8 text-[var(--muted)] sm:text-xl"
      >
        {post.description}
      </p>
    </header>

    <!-- Content -->
    <div class="space-y-14 leading-8">
      <!-- Section -->
      <section>
        <h2 class="mb-5 text-2xl font-semibold tracking-tight sm:text-3xl">
          What I did today?
        </h2>
        <p>
          Today, I wash my clothse, i ate breakast I went for studies, I retunn,
          and I was at alghoritms and the teacher allows me to pass classes
          earlier when I'll do project in python
        </p>
      </section>
    </div>

    <!-- Section -->
    <section class="py-5">
      <h2 class="mb-5 text-2xl font-semibold tracking-tight sm:text-3xl">
        Plans for tomorrow
      </h2>

      <p>
        I'll go for studies, I'll learn math, programing, skatchup, and I'll go at training
      </p>

      <!-- Section -->
      <section>
        <h2 class="mb-5 text-2xl font-semibold tracking-tight sm:text-3xl">
          How I rate this day
        </h2>
        <div class="space-y-4">
          <p>
            I'll give 2/10 I think this day was worse than yesterday so I need to give 2
          </p>
          <DayRating class="w-full" rating={2} />
        </div>
      </section>
    </section>
  </article>
</Layout>
