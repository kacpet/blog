---
import Layout from '../../../../layouts/Layout.astro'
import DayRating from '../../rateDay/rateDay.astro'

export const post = {
  day: 62,
  title: 'Day 62',
  date: '2026-11-07',
  description: 'Rest day',
  category: 'Daily',
  tags: ['Astro', 'Tailwind CSS', 'Web Development'],
}
---

<Layout>
  <article class="mx-auto max-w-3xl px-6 pb-24 pt-32">
    <!-- Header -->
    <header class="mb-16">
      <div class="flex items-center gap-3 text-sm">
        <span
          class="font-medium uppercase tracking-widest text-[var(--secondary)]"
        >
          {post.category}
        </span>

        <span class="text-[var(--border)]">/</span>

        <span class="text-[var(--muted)]">
          Day {post.day}
        </span>
      </div>

      <h1
        class="mt-6 text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl"
      >
        {post.title}
      </h1>

      <p class="mt-5 text-sm text-[var(--muted)]">
        {
          new Date(post.date).toLocaleDateString('en-GB', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          })
        }
      </p>

      <p
        class="mt-8 border-l-2 border-[var(--secondary)] pl-5 text-lg leading-8 text-[var(--muted)] sm:text-xl"
      >
        {post.description}
      </p>
    </header>

    <!-- Content -->
    <divh class="space-y-14 leading-8">
      <!-- Section -->
      <section>
        <h2 class="mb-5 text-2xl font-semibold tracking-tight sm:text-3xl">
          What I did today?
        </h2>
        <p>
          Today, I wake up lately, I made something to ate, and I watched some
          series, I couldn't watch In week, I don't think It was a good rest
          becouse my head hurts becouse of time I spend while I was watching it
          but at least It was fun
          <html lang="en">
            <head>
              <meta charset="utf-8" />
              <meta name="viewport" content="width=device-width" />
              <meta name="generator" content={Astro.generator} />
              <title>Document</title>
            </head>
            <body> </body>
          </html>
        </p>
      </section>
    </divh>

    <!-- Section -->
    <section class="py-5">
      <h2 class="mb-5 text-2xl font-semibold tracking-tight sm:text-3xl">
        Plans for tomorrow
      </h2>

      <p>I want to clean my side of the room and learn some ROS2</p>

      <!-- Section -->
      <section>
        <h2 class="mb-5 text-2xl font-semibold tracking-tight sm:text-3xl">
          How I rate this day
        </h2>
        <div class="space-y-4">
          <p>
            It's ofc 1 , I didn't do anything valuable so it cant be anything
            else
          </p>
          <DayRating class="w-full" rating={1} />
        </div>
      </section>
    </section>
  </article>
</Layout>
