---
import Layout from '../../../../layouts/Layout.astro'
import DayRating from '../../rateDay/rateDay.astro'

export const post = {
  day: 73,
  title: 'Day 73',
  date: '2026-11-18',
  description: 'nothing....',
  category: 'Daily',
  tags: ['Astro', 'Tailwind CSS', 'Web Development'],
}
---

<Layout>
  <article class="mx-auto max-w-3xl px-6 pb-24 pt-32">
    <!-- Header -->
    <header class="mb-16">
      <div class="flex items-center gap-3 text-sm">
        <span
          class="font-medium uppercase tracking-widest text-[var(--secondary)]"
        >
          {post.category}
        </span>

        <span class="text-[var(--border)]">/</span>

        <span class="text-[var(--muted)]">
          Day {post.day}
        </span>
      </div>

      <h1
        class="mt-6 text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl"
      >
        {post.title}
      </h1>

      <p class="mt-5 text-sm text-[var(--muted)]">
        {
          new Date(post.date).toLocaleDateString('en-GB', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          })
        }
      </p>

      <p
        class="mt-8 border-l-2 border-[var(--secondary)] pl-5 text-lg leading-8 text-[var(--muted)] sm:text-xl"
      >
        {post.description}
      </p>
    </header>

    <!-- Content -->
    <divh class="space-y-14 leading-8">
      <!-- Section -->
      <section>
        <h2 class="mb-5 text-2xl font-semibold tracking-tight sm:text-3xl">
          What I did today?
        </h2>
        <p>
          Today, I wake up early, I ate breakfast and I made lunch, and went for lessons, I readed
          a bit of book, and I was at lessons, and in break betwen lessons I played bilard, and after lessons,
          I ate dinner I think, I don't remember what I did after... , I wrote after 6 days. I only can say that I was tired
          or busy, becouse I didn't wrote blog
        </p>
        <html lang="en">
          <head>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width" />
            <meta name="generator" content={Astro.generator} />
            <title>Document</title>
          </head>
          <body> </body>
        </html>
      </section>
    </divh>
  </article>

  <!-- Section -->
  <section class="py-5">
    <h2 class="mb-5 text-2xl font-semibold tracking-tight sm:text-3xl">
      Plans for tomorrow
    </h2>

    <p>plans for day that already happend are pointless</p>

    <!-- Section -->
    <section>
      <h2 class="mb-5 text-2xl font-semibold tracking-tight sm:text-3xl">
        How I rate this day
      </h2>
      <div class="space-y-4">
        <p>
          I'll give 2, becouse I think I made something, but I don't remember what
        </p>
        <DayRating class="w-full" rating={2} />
      </div>
    </section>
  </section>
</Layout>
