---
import Layout from '../../../../layouts/Layout.astro'
import DayRating from '../../rateDay/rateDay.astro'

export const post = {
  day: 42,
  title: 'Day 42',
  date: '2026-10-17',
  description: 'Saturday - weekend',
  category: 'Daily',
  tags: ['Astro', 'Tailwind CSS', 'Web Development'],
}
---

<Layout>
  <article class="mx-auto max-w-3xl px-6 pb-24 pt-32">
    <!-- Header -->
    <header class="mb-16">
      <div class="flex items-center gap-3 text-sm">
        <span
          class="font-medium uppercase tracking-widest text-[var(--secondary)]"
        >
          {post.category}
        </span>

        <span class="text-[var(--border)]">/</span>

        <span class="text-[var(--muted)]">
          Day {post.day}
        </span>
      </div>

      <h1
        class="mt-6 text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl"
      >
        {post.title}
      </h1>

      <p class="mt-5 text-sm text-[var(--muted)]">
        {
          new Date(post.date).toLocaleDateString('en-GB', {
            day: 'numeric',
            month: 'long',
            year: 'numeric',
          })
        }
      </p>

      <p
        class="mt-8 border-l-2 border-[var(--secondary)] pl-5 text-lg leading-8 text-[var(--muted)] sm:text-xl"
      >
        {post.description}
      </p>
    </header>

    <!-- Content -->
    <div class="space-y-14 leading-8">
      <!-- Section -->
      <section>
        <h2 class="mb-5 text-2xl font-semibold tracking-tight sm:text-3xl">
          What I did today?
        </h2>
        <p>
          Today,I finished this series, It was really graat title is "the big
          C", I don't want to spoiler so, u can watch it by yourself,I
          recommend, I also were at badminton, where I meet another 2 badminton
          players, and we bought another hour to play with them longer, It was
          great Unfortunetly I also didn't learn anything today, but It's
          weekend, so It's time for me to rest
        </p>
      </section>
    </div>

    <!-- Section -->
    <section class="py-5">
      <h2 class="mb-5 text-2xl font-semibold tracking-tight sm:text-3xl">
        Plans for tomorrow
      </h2>

      <p>
        I'll learn somethin, I'll do projects for school, I'll go at training at
        10am
      </p>

      <!-- Section -->
      <section>
        <h2 class="mb-5 text-2xl font-semibold tracking-tight sm:text-3xl">
          How I rate this day
        </h2>
        <div class="space-y-4">
          <p>
            I'll give 1/10, I did someething today, so this day is better than
            yesterday, but still nothing valuable
          </p>
          <DayRating class="w-full" rating={1} />
        </div>
      </section>
    </section>
  </article>
</Layout>
